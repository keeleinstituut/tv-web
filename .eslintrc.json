{
  "extends": [
    "react-app",
    "react-app/jest",
    "plugin:prettier/recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint",
    "unused-imports",
    "prettier"
  ],
  "rules": {
    // Enable reporting Prettier issues as ESlint issues
    "prettier/prettier": "error",
    "quotes": [
      "error",
      "single"
    ],
    "@typescript-eslint/no-unused-vars": 1
  }
}